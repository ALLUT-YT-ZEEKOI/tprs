{% from "partials/breadcrumb.njk" import breadcrumb %}
{% from "partials/bg-image-set.njk" import bgImageSet %}
{% macro pageHero(title, subtitle, image, trail, cta) %}
<section class="page-hero" style="{{ bgImageSet(image) }}">
  <div class="page-hero__overlay"></div>
  <div class="container page-hero__inner">
    {{ breadcrumb(trail) }}
    <h1 class="page-hero__title">{{ title }}</h1>
    {% if subtitle %}<p class="page-hero__subtitle">{{ subtitle }}</p>{% endif %}
    {% if cta %}<a href="{{ cta.url }}" class="btn btn--gold" {% if cta.download %}download{% endif %}>{{ cta.label }}</a>{% endif %}
  </div>
</section>
{% endmacro %}
