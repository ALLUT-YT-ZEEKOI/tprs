<!doctype html>
<html lang="en">
<head>
{% include "partials/head.njk" %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <a class="skip-link" href="#main">Skip to content</a>

  {% include "partials/header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/floating-cta.njk" %}

  <!-- main.js bundles nav/forms/accordion/reveal/site.js — generated at build
       time by scripts/bundle-js.js; edit the individual files under
       src/assets/js/, not the bundle. -->
  <script src="/assets/js/main.js" defer></script>
  {% for src in extraJs %}
  <script src="{{ src }}" defer></script>
  {% endfor %}
</body>
</html>
