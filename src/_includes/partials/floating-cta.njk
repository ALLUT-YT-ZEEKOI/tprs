<div class="floating-cta" data-floating-cta>
  <a
    class="floating-cta__item floating-cta__item--whatsapp"
    href="https://wa.me/{{ site.whatsapp }}?text={{ site.whatsappPrefill | urlencode }}"
    target="_blank"
    rel="noopener"
  >
    <span class="floating-cta__icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.8 14.02c-.24.68-1.4 1.32-1.93 1.38-.51.06-1.03.29-3.44-.72-2.9-1.2-4.77-4.15-4.92-4.34-.14-.2-1.18-1.57-1.18-3 0-1.42.75-2.12 1.01-2.41.27-.29.58-.36.78-.36l.55.01c.18 0 .42-.07.65.5.24.58.82 2 .89 2.14.07.15.12.32.02.51-.09.2-.14.32-.28.49-.14.17-.3.38-.42.51-.14.15-.29.31-.12.6.16.29.72 1.19 1.55 1.93 1.07.95 1.96 1.25 2.25 1.39.29.14.46.12.63-.07.17-.2.72-.84.92-1.13.19-.29.39-.24.65-.14.27.1 1.69.8 1.98.94.29.15.49.22.56.34.07.13.07.75-.17 1.43z"/></svg>
    </span>
    <span class="floating-cta__label">WhatsApp</span>
  </a>

  <a class="floating-cta__item floating-cta__item--call" href="tel:{{ site.phone }}">
    <span class="floating-cta__icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.24.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
    </span>
    <span class="floating-cta__label">Let's Talk</span>
  </a>

  <a class="floating-cta__item floating-cta__item--email" data-email-link href="#">
    <span class="floating-cta__icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M2 6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6zm2 0l8 6 8-6H4zm16 2.24l-7.4 5.55a1 1 0 0 1-1.2 0L4 8.24V18h16V8.24z"/></svg>
    </span>
    <span class="floating-cta__label">Email</span>
  </a>

  <a class="floating-cta__item floating-cta__item--enquiry" href="/contact-us/#form">
    <span class="floating-cta__icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M3 3h18v14H7l-4 4V3zm4 5h10v2H7V8zm0 4h6v2H7v-2z"/></svg>
    </span>
    <span class="floating-cta__label">Enquiry</span>
  </a>

  <button type="button" class="floating-cta__item floating-cta__item--top" data-scroll-top hidden>
    <span class="floating-cta__icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l8 8-1.41 1.41L13 7.83V20h-2V7.83l-5.59 5.58L4 12z"/></svg>
    </span>
    <span class="floating-cta__label">Top</span>
  </button>
</div>
