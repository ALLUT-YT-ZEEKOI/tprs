<section class="hero" data-hero>
  <div class="hero__media">
    <video
      class="hero__video"
      data-hero-video
      data-src="{{ home.hero.video }}"
      poster="{{ home.hero.poster }}"
      muted
      loop
      playsinline
      preload="none"
    ></video>
    <picture class="hero__poster-fallback" data-hero-poster>
      <source media="(max-width: 767px)" srcset="{{ home.hero.posterPortrait | webp }}" type="image/webp" />
      <source media="(max-width: 767px)" srcset="{{ home.hero.posterPortrait }}" />
      <source srcset="{{ home.hero.poster | webp }}" type="image/webp" />
      <img src="{{ home.hero.poster }}" alt="" fetchpriority="high" />
    </picture>
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__inner">
    <p class="hero__kicker hero__fade-in">{{ home.hero.kicker }}</p>
    <h1 class="hero__headline">{{ home.hero.headline }}</h1>
    <a href="{{ home.hero.cta.url }}" class="btn btn--gold hero__cta hero__fade-in" style="animation-delay: 150ms;">{{ home.hero.cta.label }}</a>
  </div>

  <a href="#intro" class="hero__scroll-cue" aria-label="Scroll to content">
    <svg width="16" height="26" viewBox="0 0 16 26" aria-hidden="true" focusable="false">
      <rect x="1" y="1" width="14" height="24" rx="7" stroke="currentColor" stroke-width="1.5" fill="none"/>
      <circle class="hero__scroll-dot" cx="8" cy="8" r="2" fill="currentColor"/>
    </svg>
  </a>
</section>
