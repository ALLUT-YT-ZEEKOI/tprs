<section class="glass-edge section">
  <div class="container glass-edge__inner">
    <div class="spotlight reveal" data-reveal>
      <p class="eyebrow">{{ home.spotlight.eyebrow }}</p>
      <h2>{{ home.spotlight.heading }}</h2>
      <ol class="spotlight__list">
        {% for item in home.spotlight.items %}
        <li class="spotlight__item">
          <a href="{{ item.url }}" class="spotlight__link">
            <span class="spotlight__number">{{ item.number }}</span>
            <span class="spotlight__body">
              <span class="spotlight__category">{{ item.category }}</span>
              <span class="spotlight__title">{{ item.title }}</span>
            </span>
            <svg class="spotlight__arrow" width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><path d="M1 7h15M11 1l6 6-6 6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </li>
        {% endfor %}
      </ol>
    </div>

    <div class="latest-update reveal" data-reveal data-reveal-delay="150">
      <p class="eyebrow">{{ home.latestUpdate.eyebrow }}</p>
      <h2>{{ home.latestUpdate.heading }}</h2>
      <div class="latest-update__card">
        <h3 class="latest-update__title">{{ home.latestUpdate.title }}</h3>
        <dl class="latest-update__meta">
          <div><dt>Dates</dt><dd>{{ home.latestUpdate.dates }}</dd></div>
          <div><dt>Location</dt><dd>{{ home.latestUpdate.location }}</dd></div>
          <div><dt>Booth</dt><dd>{{ home.latestUpdate.booth }}</dd></div>
        </dl>
        <p class="latest-update__tagline">{{ home.latestUpdate.tagline }}</p>
        <a href="{{ home.latestUpdate.cta.url }}" class="btn btn--outline">{{ home.latestUpdate.cta.label }}</a>
      </div>
    </div>
  </div>
</section>
