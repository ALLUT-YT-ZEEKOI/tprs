<section class="glass-hub section">
  <div class="container">
    <div class="section-head reveal" data-reveal>
      <p class="eyebrow">{{ home.glassHub.eyebrow }}</p>
      <h2>{{ home.glassHub.heading }}</h2>
    </div>
    <div class="glass-hub__grid grid">
      {% for social in site.socials %}
      <a href="{{ social.url }}" target="_blank" rel="noopener" class="social-card reveal" data-reveal data-reveal-delay="{{ loop.index0 * 80 }}">
        <span class="social-card__icon" aria-hidden="true">
          {% if social.name == "LinkedIn" %}
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.6c0-1.34-.02-3.07-1.9-3.07-1.9 0-2.2 1.44-2.2 2.97V21h-4V9z"/></svg>
          {% elif social.name == "Instagram" %}
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c2.72 0 3.06.01 4.12.06 1.06.05 1.79.22 2.43.47.66.26 1.22.6 1.77 1.15.55.55.89 1.11 1.15 1.77.25.64.42 1.37.47 2.43.05 1.06.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.06-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.15 1.77 4.9 4.9 0 0 1-1.77 1.15c-.64.25-1.37.42-2.43.47-1.06.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.06-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.25-.64-.42-1.37-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.06.22-1.79.47-2.43.26-.66.6-1.22 1.15-1.77A4.9 4.9 0 0 1 5.45.53c.64-.25 1.37-.42 2.43-.47C8.94.01 9.28 0 12 0zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zm5.2-8.4a1.17 1.17 0 1 1 0-2.34 1.17 1.17 0 0 1 0 2.34z" transform="translate(0 2)"/></svg>
          {% elif social.name == "Facebook" %}
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.25-1.5 1.55-1.5H16.7V3.7c-.3-.05-1.3-.13-2.46-.13-2.43 0-4.1 1.48-4.1 4.2V10H7.5v3.1h2.64V21h3.36z"/></svg>
          {% elif social.name == "YouTube" %}
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.5-.45-5.16a2.9 2.9 0 0 0-2.03-2.05C18.9 4.3 12 4.3 12 4.3s-6.9 0-8.52.49a2.9 2.9 0 0 0-2.03 2.05C1 8.5 1 12 1 12s0 3.5.45 5.16a2.9 2.9 0 0 0 2.03 2.05c1.62.49 8.52.49 8.52.49s6.9 0 8.52-.49a2.9 2.9 0 0 0 2.03-2.05C23 15.5 23 12 23 12zM9.75 15.5v-7l6 3.5-6 3.5z"/></svg>
          {% elif social.name == "X" %}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.6 8.7L23.3 22H16.6l-5.2-6.8L5.4 22H2.3l8.1-9.3L1.7 2h6.9l4.7 6.2L18.9 2zm-1.2 18h1.7L7.4 4H5.6L17.7 20z"/></svg>
          {% endif %}
        </span>
        <span class="social-card__name">{{ social.name }}</span>
        <span class="social-card__tagline">{{ social.tagline }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
