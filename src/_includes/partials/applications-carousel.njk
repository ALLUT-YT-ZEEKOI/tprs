{% from "partials/bg-image-set.njk" import bgImageSet %}
<div class="applications-carousel" data-carousel>
  <ul class="applications-carousel__track" data-carousel-track>
    {% for app in applications %}
    <li class="application-card" style="{{ bgImageSet(app.image) }}">
      <a href="{{ app.url }}" class="application-card__link">
        <div class="application-card__overlay"></div>
        <h3 class="application-card__title">{{ app.label }}</h3>
        <p class="application-card__tagline">{{ app.tagline }}</p>
      </a>
    </li>
    {% endfor %}
  </ul>
</div>
<div class="carousel-nav">
  <button type="button" class="carousel-nav__btn" data-carousel-prev aria-label="Previous">
    <svg width="8" height="14" viewBox="0 0 8 14" aria-hidden="true"><path d="M7 1L1 7l6 6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button type="button" class="carousel-nav__btn" data-carousel-next aria-label="Next">
    <svg width="8" height="14" viewBox="0 0 8 14" aria-hidden="true"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>
