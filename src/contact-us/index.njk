<section class="section">
  <div class="container">
    <p class="prose reveal" data-reveal>At TPRS Glass, every connection is an opportunity to build trust and innovation. Our team is dedicated to delivering advanced glass solutions that reflect precision, purpose, and partnership. Reach out to us, and let's shape the future of glass together.</p>
  </div>
</section>

<section class="section bg-alt" id="form">
  <div class="container contact-layout">
    <div class="contact-form-wrap reveal" data-reveal>
      <p class="eyebrow">Contact Us</p>
      <h2>Have questions? Get in touch!</h2>
      <p class="contact-form-wrap__lede">Let's Connect and Explore Your Glass Visions.</p>

      <form class="contact-form" data-contact-form data-endpoint="{{ env.contactFormEndpoint }}" novalidate>
        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="contact-name" class="visually-hidden">Name</label>
            <input type="text" id="contact-name" name="your-name" placeholder="Name" required autocomplete="name" />
            <span class="form-error" data-error-for="contact-name" role="alert"></span>
          </div>
          <div class="contact-form__field">
            <label for="contact-email" class="visually-hidden">Email Address</label>
            <input type="email" id="contact-email" name="your-email" placeholder="Email Address" required autocomplete="email" />
            <span class="form-error" data-error-for="contact-email" role="alert"></span>
          </div>
        </div>
        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="contact-phone" class="visually-hidden">Phone</label>
            <input type="tel" id="contact-phone" name="phone" placeholder="Phone" required autocomplete="tel" />
            <span class="form-error" data-error-for="contact-phone" role="alert"></span>
          </div>
          <div class="contact-form__field">
            <label for="contact-subject" class="visually-hidden">Subject</label>
            <input type="text" id="contact-subject" name="subject" placeholder="Subject" required />
            <span class="form-error" data-error-for="contact-subject" role="alert"></span>
          </div>
        </div>
        <div class="contact-form__field">
          <label for="contact-message" class="visually-hidden">Message</label>
          <textarea id="contact-message" name="your-message" rows="6" placeholder="Your Message" required></textarea>
          <span class="form-error" data-error-for="contact-message" role="alert"></span>
        </div>

        <!-- honeypot -->
        <div class="form-honeypot" aria-hidden="true">
          <label for="contact-company">Company</label>
          <input type="text" id="contact-company" name="company" tabindex="-1" autocomplete="off" />
        </div>

        <div class="newsletter__consent">
          <input type="checkbox" id="contact-consent" name="consent" required />
          <label for="contact-consent">I agree that my data is collected and stored.</label>
        </div>

        <button type="submit" class="btn btn--primary">
          <span class="btn__label">Send Message</span>
          <span class="btn__spinner" hidden></span>
        </button>
        <p class="form-status" data-form-status role="status" aria-live="polite"></p>
      </form>
    </div>

    <div class="contact-map reveal" data-reveal data-reveal-delay="120">
      <iframe
        src="https://maps.google.com/maps?t=m&output=embed&iwloc=near&z=12&q=139%2C+Manapet+Road%2C+Kanniakoil+Bahour+Commune%2C+Manapet%2C+Puducherry%2C+India."
        title="TPRS Enterprises — Puducherry HQ location"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>

